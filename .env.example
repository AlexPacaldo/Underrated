VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GCASH_ACCOUNT_NAME=Your GCash Name
VITE_GCASH_ACCOUNT_NUMBER=09XX XXX XXXX
VITE_GCASH_QR_IMAGE_URL=/gcash-qr.png
VITE_BANK_NAME=Your Bank
VITE_BANK_ACCOUNT_NAME=Your Account Name
VITE_BANK_ACCOUNT_NUMBER=0000 0000 0000

# ---------------------------------------------------------------------------
# Server only. Read by server/index.ts and the Bigate integration.
#
# These must NOT be prefixed with VITE_. Vite inlines every VITE_* variable into
# the JavaScript shipped to the browser, so a VITE_-prefixed Bigcode or
# service-role key would be readable by anyone who opens developer tools.
#
# Copy these into the real environment for the Node process (not .env.local, which
# Vite only reads for the client build) and restart the server after changing one.
# ---------------------------------------------------------------------------

# Supabase, for the server-side service-role client. Bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bigate Gateway
BIGATE_BASE_URL=https://api.bigate.example/v1
BIGATE_BIGCODE=your-bigcode
BIGATE_ACCOUNT_ID=your-account-id
# Sent as "Authorization: <scheme> <bigcode>". Set to Bearer if your account docs
# say so; the default is what the docs this integration was written against used.
BIGATE_AUTH_SCHEME=Bigcode
BIGATE_DEFAULT_COURIER_CODE=JNT
BIGATE_DEFAULT_SERVICE_CODE=
# Shared secret for the tracking webhook's HMAC-SHA256 signature. Required: with
# it unset, POST /api/logistics/bigate/webhook answers 503 and refuses every
# event rather than accepting unauthenticated writes.
BIGATE_WEBHOOK_SECRET=
# Optional. Comma-separated source addresses Bigate may post from. Empty allows
# any address, which is acceptable only while the signature secret is strong.
BIGATE_WEBHOOK_IP_ALLOWLIST=
# 15 seconds. Raise it if your gateway is slow on a first booking of the day.
BIGATE_REQUEST_TIMEOUT_MS=15000
# Retries for idempotent calls only. Shipment creation is never retried
# automatically, regardless of this value.
BIGATE_RETRY_ATTEMPTS=2
# Optional. Hosts permitted in a stored waybill PDF link. Empty accepts any
# https host; set it in production so a link always points at the gateway.
BIGATE_WAYBILL_HOST_ALLOWLIST=
