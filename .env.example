VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GCASH_ACCOUNT_NAME=Your GCash Name
VITE_GCASH_ACCOUNT_NUMBER=09XX XXX XXXX
VITE_GCASH_QR_IMAGE_URL=/gcash-qr.png
VITE_BANK_NAME=Your Bank
VITE_BANK_ACCOUNT_NAME=Your Account Name
VITE_BANK_ACCOUNT_NUMBER=0000 0000 0000
# Where customers go to pay by PayPal: a paypal.me link, a PayPal Business
# payment link, or an invoice URL. Leave empty and the checkout says PayPal is
# not set up rather than offering a dead button. No PayPal API is involved, so
# there is nothing secret here and no client id is needed.
VITE_PAYPAL_LINK=

# ---------------------------------------------------------------------------
# Server only. Read by server/index.ts and the Bigate integration.
#
# These must NOT be prefixed with VITE_. Vite inlines every VITE_* variable into
# the JavaScript shipped to the browser, so a VITE_-prefixed Bigcode or
# service-role key would be readable by anyone who opens developer tools.
#
# Copy these into the real environment for the Node process (not .env.local, which
# Vite only reads for the client build) and restart the server after changing one.
# ---------------------------------------------------------------------------

# Supabase, for the server-side service-role client. Bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bigate Gateway
BIGATE_BASE_URL=https://api.bigate.example/v1
BIGATE_BIGCODE=your-bigcode
BIGATE_ACCOUNT_ID=your-account-id
# Sent as "Authorization: <scheme> <bigcode>". Set to Bearer if your account docs
# say so; the default is what the docs this integration was written against used.
BIGATE_AUTH_SCHEME=Bigcode
BIGATE_DEFAULT_COURIER_CODE=JNT
BIGATE_DEFAULT_SERVICE_CODE=
# Shared secret for the tracking webhook's HMAC-SHA256 signature. Required: with
# it unset, POST /api/logistics/bigate/webhook answers 503 and refuses every
# event rather than accepting unauthenticated writes.
BIGATE_WEBHOOK_SECRET=
# Optional. Comma-separated source addresses Bigate may post from. Empty allows
# any address, which is acceptable only while the signature secret is strong.
BIGATE_WEBHOOK_IP_ALLOWLIST=

# How an inbound callback proves it is genuine. The scheme was written against a
# guess and never confirmed against a live account, so it is configuration rather
# than code: a wrong guess rejects every callback while the rest of the store
# looks healthy.
#
#   hmac      Digest over the raw request body. The default, and the only mode
#             that authenticates the body itself.
#   token     A shared secret sent verbatim in a header or query parameter.
#             Reuses BIGATE_WEBHOOK_SECRET. Weaker than a digest, because a
#             captured token can be replayed, but several courier gateways work
#             this way.
#   ip_only   No body credential. Refuses to start without an IP allowlist, so it
#             cannot be set by accident into an open endpoint. Use only if Bigate
#             documents that its callbacks are unsigned.
#
# Check what is live at GET /api/logistics/health, under webhook_auth.
BIGATE_WEBHOOK_AUTH=hmac
# Digest algorithm and encoding, for hmac mode. Hex is the common default; base64
# is what several gateways send instead.
BIGATE_WEBHOOK_HMAC_ALGORITHM=sha256
BIGATE_WEBHOOK_HMAC_ENCODING=hex
# Header names to read a digest from. The default list covers the spellings seen
# in the wild; set this only if Bigate uses something else entirely.
BIGATE_WEBHOOK_SIGNATURE_HEADERS=
# For token mode: header names to read the shared token from, and the query
# parameter to fall back to. A "Bearer " prefix on the header value is tolerated.
BIGATE_WEBHOOK_TOKEN_HEADERS=
BIGATE_WEBHOOK_TOKEN_QUERY_PARAM=token
# Replay protection, off by default. A digest signed over "<timestamp>.<body>" is
# only fresh for as long as this window; outside it the request is rejected. It
# is off because a gateway that signs only the body has no timestamp to check, and
# enforcing a window against it would reject every real callback. Watch a few live
# deliveries in the logs first, then set 300 and confirm they still arrive.
# 0 means off, in both the literal and the empty case.
BIGATE_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=0
BIGATE_WEBHOOK_TIMESTAMP_HEADER=x-bigate-timestamp
# Also accept a t= segment inside the signature header, and refuse a signed
# request that carries no timestamp at all. Leave false unless Bigate documents
# that it signs one.
BIGATE_WEBHOOK_REQUIRE_TIMESTAMP=false

# 15 seconds. Raise it if your gateway is slow on a first booking of the day.
BIGATE_REQUEST_TIMEOUT_MS=15000
# Retries for idempotent calls only. Shipment creation is never retried
# automatically, regardless of this value.
BIGATE_RETRY_ATTEMPTS=2
# Optional. Hosts permitted in a stored waybill PDF link. Empty accepts any
# https host; set it in production so a link always points at the gateway.
BIGATE_WAYBILL_HOST_ALLOWLIST=
